# Google Places API keys (pool de 3, round-robin)
GOOGLE_PLACES_KEY_1=
GOOGLE_PLACES_KEY_2=
GOOGLE_PLACES_KEY_3=

# Prospectus-Kernel webhook (Fase 3)
PROSPECTUS_WEBHOOK_URL=http://localhost:8000/enrich
PROSPECTUS_WEBHOOK_SECRET=

# Server
PORT=3001

# Scan limits
MAX_CONCURRENT_PHONES=10
WHATSAPP_RATE_LIMIT_MS=100
NEGATIVE_CACHE_TTL_DAYS=30

# CNPJ dump path (Kaggle Parquet converted to SQLite)
CNPJ_DB_PATH=./data/cnpj.db

# Target verticals (CNAE codes)
CNAE_TARGETS=2330300,4742700,4330401

# State filter for OSM pre-filter (Fase 3)
TARGET_STATE=SP
